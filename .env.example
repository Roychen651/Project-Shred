# Copy to .env.local and fill in from your Supabase project's API settings.
#
# Both of these are public by design — they ship to the browser. Row Level
# Security is what protects the data, not the secrecy of the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service-role key is deliberately NOT listed here. This app never needs it:
# every table is reached through RLS as the signed-in user. Do not add it to
# Vercel or to any client-reachable environment — it bypasses RLS entirely.
